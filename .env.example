# Database
DATABASE_URL=sqlite:///./runedact.db

# LLM providers. Without keys the app falls back to built-in mock hints.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# auto | gemini | openai | mock
LLM_PROVIDER=auto

# API hardening
API_AUTH_ENABLED=false
API_KEY=
RATE_LIMIT_PER_MINUTE=120

# Comma-separated, parsed as JSON-style list by pydantic-settings if needed
# Example: ["http://localhost:3000","http://127.0.0.1:3000"]
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Sandbox limits
SANDBOX_TIMEOUT_SECONDS=2
SANDBOX_MEMORY_LIMIT_MB=64
SANDBOX_MAX_PROCESSES=1
SANDBOX_MODE=process
SANDBOX_DOCKER_IMAGE=python:3.12-alpine
SANDBOX_DISABLE_NETWORK=true
